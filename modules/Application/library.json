{
  "name": "Application",
  "version": "0.1.0",
  "description": "Application composition root for the ESP32 App Foundation framework",
  "keywords": ["esp32", "framework", "application"],
  "repository": {
    "type": "git",
    "url": "https://github.com/cblabs-org/esp32-app-foundation"
  },
  "dependencies": {
    "EventBus": "*",
    "DataManager": "*",
    "WebServer": "*",
    "ConfigManager": "*",
    "WifiManager": "*",
    "KeyManager": "*",
    "AuthManager": "*",
    "DeviceCrypto": "*",
    "PreconditionEngine": "*"
  },
  "build": {
    "flags": ["-I../../include"],
    "extraScript": "exclude_on_native.py"
  }
}
