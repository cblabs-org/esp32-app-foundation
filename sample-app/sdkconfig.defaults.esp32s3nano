# ESP32 App Foundation — sdkconfig.defaults.esp32s3nano
# Inherits base defaults; S3-specific overrides below.
# Arduino framework autostart — enables the Arduino core's app_main() wrapper
# which calls setup() then drives the loop() task. Without this, ESP-IDF's
# app_startup.c has an undefined reference to app_main().
CONFIG_AUTOSTART_ARDUINO=y

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# S3 main task stack — larger due to PSRAM availability
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

CONFIG_LITTLEFS_FOR_IDF_3_2=y

CONFIG_BT_ENABLED=n

# S3 OPI PSRAM — Waveshare ESP32-S3-Nano has 8MB OPI PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=y

CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=8192

CONFIG_FREERTOS_HZ=1000
