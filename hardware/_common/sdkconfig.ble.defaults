# =============================================================================
# ESP32 App Foundation — BLE sdkconfig fragment
# =============================================================================
# Purpose:  Enable the NimBLE BLE stack for environments that define WITH_BLE.
#           This fragment is layered LAST in SDKCONFIG_DEFAULTS for BLE envs,
#           so its values WIN over sdkconfig.defaults (which sets BT_ENABLED=n).
#
# Wired via: board_build.cmake_extra_args in platformio.ini [env:esp32s3nano_ble].
# Authoritative: RFC #225 rev 2 §16.2.
# =============================================================================

# --- Bluetooth controller & host ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# --- NimBLE roles (all four for peripheral + central) ---
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y

# --- Connection budget: 3 peripheral + 1 central ---
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4

# --- Bonding (NVS-persisted, Just Works) ---
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y

# --- NVS persistence for bonding data ---
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# --- Memory allocation: use internal DRAM (IDF default) ---
# EXTERNAL mode routes all NimBLE allocs to PSRAM, which causes three
# failure modes on ESP32-S3: (1) BLE controller DMA cannot access PSRAM,
# (2) Xtensa atomic instructions fail on PSRAM (cross-core spinlock panics),
# (3) PSRAM bus contention inflates init past TWDT timeout.
# INTERNAL is the IDF default and ensures all NimBLE allocs use fast DRAM.
# See ESP-IDF issues IDFGH-7560, IDFGH-10048.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y

# --- Legacy advertising only (v1 scope; no extended advertising) ---
CONFIG_BT_NIMBLE_EXT_ADV=n

# --- Wi-Fi / BLE coexistence (software) ---
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- Interrupt WDT: disabled for BLE environments ---
# The BLE controller ROM code dumps EM_BASE_REG_LUT under a spinlock
# that masks interrupts on Core 0 for >800ms during init. This is
# inside the ROM and cannot be patched. INT_WDT must be disabled
# for BLE envs to allow controller init to complete.
CONFIG_ESP_INT_WDT=n

# --- Task WDT: relaxed for BLE controller init ---
# The BLE controller init blocks Core 0 for >5s under a spinlock,
# starving both the calling task AND the idle task. Increase timeout
# to 30s and disable idle-task checks to prevent TG0WDT_SYS_RST.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
