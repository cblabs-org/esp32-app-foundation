<screen>
    <view width="100%" height="100%" style_bg_color="0x0D1117" style_bg_opa="255"
        scrollable="false">

    <!-- Arc gauge: CENTER, 216×216, 270° sweep open at bottom -->
    <lv_arc name="diag_arc"
            bind_value="sys_diag_arc_value"
            value="0" min_value="0" max_value="100"
            bg_start_angle="135" bg_end_angle="45"
            mode="normal"
            align="center" x="0" y="0"
            width="216" height="216"
            style_arc_color-indicator="0xF0A020"
            style_bg_opa-knob="0"
            style_border_width-knob="0"
            scrollable="false" />

    <!-- Category label: CENTER, offset (0, -58), content-fit -->
    <lv_label name="diag_category"
              bind_text="sys_diag_category" text="TEMPERATURE"
              align="center" x="0" y="-58"
              width="content" height="content"
              style_text_font="montserrat_12"
              style_text_color="0x8B929D" />

    <!-- Counter label: CENTER, offset (0, -36), content-fit -->
    <lv_label name="diag_counter"
              bind_text="sys_diag_counter" text="3 / 6"
              align="center" x="0" y="-36"
              width="content" height="content"
              style_text_font="montserrat_12"
              style_text_color="0x5B6270" />

    <!-- Large value: CENTER, offset (0, -2), content-fit -->
    <lv_label name="diag_value"
              bind_text="sys_diag_value" text="78°C"
              align="center" x="0" y="-2"
              width="content" height="content"
              style_text_font="montserrat_40"
              style_text_color="0xFFFFFF" />

    <!-- Status label: CENTER, offset (0, 36), content-fit -->
    <lv_label name="diag_status"
              bind_text="sys_diag_status" text="HIGH"
              align="center" x="0" y="36"
              width="content" height="content"
              style_text_font="montserrat_14"
              style_text_color="0xF0A020" />

    </view>
</screen>
