<screen>
    <view width="100%" height="100%" style_bg_color="0xF5F5F5" style_bg_opa="255"
        scrollable="false">

    <!-- Logo: CENTER, offset (0, -40), 180×58 fixed -->
    <lv_image name="boot_logo"
              src="img_cblabs_logo"
              align="center" x="0" y="-40"
              width="180" height="58" />

    <!-- Title: CENTER, offset (0, 20), 193×48 fixed, wrapped text -->
    <lv_label name="boot_title"
              text="ESP32 App Foundation"
              bind_text="sys_app_title"
              align="center" x="0" y="20"
              width="193" height="48"
              long_mode="wrap"
              style_text_font="montserrat_18"
              style_text_color="0x7B2C29"
              style_text_align="center" />

    <!-- Progress bar: CENTER, offset (0, 52), 140×8 fixed -->
    <lv_bar name="boot_progress_bar"
            bind_value="sys_boot_progress"
            min_value="0" max_value="100"
            align="center" x="0" y="52"
            width="140" height="8"
            style_bg_color="0xDDD1D0"
            style_bg_color-indicator="0x7B2C29" />

    <!-- Status label: CENTER, offset (0, 74), content-fit -->
    <lv_label name="boot_status_label"
              bind_text="sys_boot_status"
              text="Initialising..."
              align="center" x="0" y="74"
              width="content" height="content"
              style_text_font="montserrat_12"
              style_text_color="0x7D7370" />

    <!-- Fade overlay: CENTER, 240×240 full-screen, on top -->
    <lv_obj name="boot_fade_overlay"
            align="center" x="0" y="0"
            width="240" height="240"
            style_bg_opa="0" style_border_width="0" style_pad_all="0"
            scrollable="false">
        <event_cb trigger="ready" callback="ui_boot_fade_overlay_loaded" />
    </lv_obj>

    </view>
</screen>
