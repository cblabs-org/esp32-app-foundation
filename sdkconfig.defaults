# ESP32 App Foundation — sdkconfig.defaults (esp32dev)
# Arduino framework autostart — enables the Arduino core's app_main() wrapper
# which calls setup() then drives the loop() task. Without this, ESP-IDF's
# app_startup.c has an undefined reference to app_main().
CONFIG_AUTOSTART_ARDUINO=y

# OTA rollback support — MUST NOT be disabled
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Increase main task stack for complex startup sequences
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable LittleFS
CONFIG_LITTLEFS_FOR_IDF_3_2=y

# Disable Bluetooth to reclaim ~70KB RAM (not needed for this framework)
CONFIG_BT_ENABLED=n

# HTTPS/TLS — mbedTLS heap-friendly settings
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# FreeRTOS tick rate
CONFIG_FREERTOS_HZ=1000

# --- PR-10: Disable unused ESP-IDF components to reduce binary size ---

# WiFi Provisioning — framework uses its own wifiManager with captive portal.
# NOTE: No Kconfig toggle exists to fully disable wifi_provisioning in Arduino+ESP-IDF.
# The component compiles but the linker GC strips unused symbols.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# SPIFFS — framework uses LittleFS exclusively.
# NOTE: CONFIG_SPIFFS_MAX_PARTITIONS has Kconfig min=1; cannot be set to 0.
# The SPIFFS library compiles but is unused; linker GC handles dead code.

# FatFS — no SD card support in framework.
# NOTE: CONFIG_FATFS_VOLUME_COUNT has Kconfig min=1; cannot be set to 0.
# The FatFS library compiles but is unused; linker GC handles dead code.

# ESP Console — UART must be enabled for boot diagnostics and ESP_LOG* output.
# WARNING: CONFIG_ESP_CONSOLE_NONE silences ALL serial output. Never enable it.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# PPP/Modem — no cellular modem hardware
CONFIG_LWIP_PPP_SUPPORT=n

# libsodium — all crypto handled by mbedTLS (OTA signature verification, etc.)
CONFIG_LIBSODIUM_USE_MBEDTLS_SHA=n

# --- PR-10 WO2: Compiler & linker optimization for size ---

# Switch from -Og (debug) to -Os (optimize for size)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Newlib nano — smaller printf/scanf (~25-50KB savings)
CONFIG_NEWLIB_NANO_FORMAT=y

# Strip VERBOSE and DEBUG log strings at compile time
CONFIG_LOG_MAXIMUM_LEVEL=3

# Use silent assertions — saves flash from assertion message strings
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# --- PR-10 WO3: mbedTLS cipher pruning & LWIP optimization ---

# Disable unused symmetric ciphers (framework only uses AES)
CONFIG_MBEDTLS_DES_C=n
CONFIG_MBEDTLS_BLOWFISH_C=n
CONFIG_MBEDTLS_XTEA_C=n
CONFIG_MBEDTLS_CAMELLIA_C=n
CONFIG_MBEDTLS_RC4_DISABLED=y

# Disable DHE key exchange (use ECDHE instead for TLS)
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=n
# PSK MUST be enabled — Arduino's ssl_client.cpp wraps ALL SSL functions
# (ssl_init, start_ssl_client, etc.) inside #if MBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED.
# Disabling all PSK modes compiles out the entire SSL backend, breaking WiFiClientSecure.
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# Disable RIPEMD-160 (framework uses SHA-256 and MD5 only)
CONFIG_MBEDTLS_RIPEMD160_C=n

# Disable IPv6 — framework is IPv4-only
CONFIG_LWIP_IPV6=n

# --- PR-10 WO4: Final sweep ---

# Remove ESP error code-to-string lookup table (~3-8KB of string constants)
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n

# Disable ChaCha20-Poly1305 cipher suite (framework uses AES-based TLS)
CONFIG_MBEDTLS_CHACHA20_C=n
CONFIG_MBEDTLS_POLY1305_C=n
CONFIG_MBEDTLS_CHACHAPOLY_C=n

# Disable unused ECC curves — keep only secp256r1 (P-256, standard TLS curve)
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=n

# Disable WPS (WiFi Protected Setup — not used)
CONFIG_ESP_WIFI_ENABLE_WPS=n

# --- PR-14: OTA production hardening ---

# Task watchdog panic — triggers reboot on hung OTA downloads,
# enabling auto-rollback via the bootloader if the firmware
# has not yet been blessed by markAppValid().
CONFIG_ESP_TASK_WDT_PANIC=y
