{
  "name": "esp32-app-foundation",
  "version": "0.1.0",
  "description": "Reusable ESP32 application framework — Arduino + ESP-IDF dual-framework. Provides a composition root, interface contracts, two-tier vector module registration, and a clean Hollywood-Principle entry point.",
  "keywords": [
    "esp32",
    "framework",
    "arduino",
    "espidf",
    "iot",
    "application",
    "ota",
    "littlefs"
  ],
  "authors": [
    {
      "name": "CB Labs",
      "url": "https://github.com/cblabs-org"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cblabs-org/esp32-app-foundation"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/cblabs-org/esp32-app-foundation",
  "export": {
    "include": [
      "include",
      "modules",
      "lib"
    ],
    "exclude": [
      "src",
      "test",
      "docs",
      ".agents",
      "scripts",
      "web",
      "template"
    ]
  },
  "build": {
    "srcFilter": [
      "+<modules/>",
      "+<lib/>",
      "-<src/>",
      "-<test/>",
      "-<template/>"
    ],
    "flags": [
      "-I include"
    ]
  },
  "dependencies": {
    "bblanchon/ArduinoJson": "^7.4.3",
    "ESP32Async/ESPAsyncWebServer": "^3.7.7",
    "ESP32Async/AsyncTCP": "^3.4.5",
    "olikraus/U8g2": "^2.36.18"
  },
  "frameworks": ["arduino", "espidf"],
  "platforms": ["espressif32"]
}
